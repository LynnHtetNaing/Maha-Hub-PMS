# Security headers for Cloudflare Pages (maha-hub.com after the move; maha-hub.pages.dev for testing).
# GitHub Pages ignores this file, so it changes nothing there.
# The first block is enforced. The Content-Security-Policy is REPORT-ONLY on purpose: it cannot break
# anything, it only prints warnings in the browser console. After a week of clean console checks it can be
# promoted by renaming the header to Content-Security-Policy.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://wragaoglvksbbgmfjyzp.supabase.co wss://wragaoglvksbbgmfjyzp.supabase.co https://*.workers.dev https://api.stripe.com https://generativelanguage.googleapis.com https://api.anthropic.com https://www.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; object-src 'none'

# The service worker file must always be re-checked so updates reach hotels quickly.
/sw.js
  Cache-Control: no-cache
